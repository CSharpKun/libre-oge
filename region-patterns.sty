\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{region-patterns}[2026/01/01 v2.0 Background regional patterns package for Russian Exams]

\RequirePackage{pgffor}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{kvoptions}
\RequirePackage{xcolor}

\SetupKeyvalOptions{
	family=MYPKG,
	prefix=MYPKG@
}

\DeclareStringOption[0]{seed}
\DeclareStringOption[gray!40]{color}
\DeclareStringOption[0.75]{step}
\DeclareStringOption[0.3]{size}
\DeclareBoolOption[false]{dense}

\ProcessKeyvalOptions*

% Инициализация детерминированного ГПСЧ
\newcommand{\setdeterministicseed}[1]{%
	\pgfmathsetseed{#1}%
}

% Базовые примитивы
\newcommand{\drmcircle}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm + 0.5*\size cm) circle (0.5*\size cm);
}

\newcommand{\drmsquare}{%
	\draw (\x*\step cm, \y*\step cm) rectangle ++(\size cm,\size cm);
}

\newcommand{\drmx}{%
	\draw (\x*\step cm, \y*\step cm) -- ++(\size cm,\size cm);
	\draw (\x*\step cm + \size cm, \y*\step cm) -- ++(-\size cm,\size cm);
}

\newcommand{\drmminus}{%
	\draw (\x*\step cm, \y*\step cm + 0.5*\size cm) -- ++(\size cm,0cm);
}

\newcommand{\drmup}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm) -- ++(0cm,\size cm);
}

\newcommand{\drmtriangle}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm) -- 
	(\x*\step cm + \size cm, \y*\step cm + \size cm) -- 
	(\x*\step cm, \y*\step cm + \size cm) -- cycle;
}

\newcommand{\drmtriangledown}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm + \size cm) -- 
	(\x*\step cm + \size cm, \y*\step cm) -- 
	(\x*\step cm, \y*\step cm) -- cycle;
}

\newcommand{\drmdiamond}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm) -- 
	(\x*\step cm + \size cm, \y*\step cm + 0.5*\size cm) -- 
	(\x*\step cm + 0.5*\size cm, \y*\step cm + \size cm) -- 
	(\x*\step cm, \y*\step cm + 0.5*\size cm) -- cycle;
}

\newcommand{\drmhexagon}{%
	\draw (\x*\step cm + 0.25*\size cm, \y*\step cm) -- 
	(\x*\step cm + 0.75*\size cm, \y*\step cm) -- 
	(\x*\step cm + \size cm, \y*\step cm + 0.5*\size cm) -- 
	(\x*\step cm + 0.75*\size cm, \y*\step cm + \size cm) -- 
	(\x*\step cm + 0.25*\size cm, \y*\step cm + \size cm) -- 
	(\x*\step cm, \y*\step cm + 0.5*\size cm) -- cycle;
}

\newcommand{\drmstar}{%
	\foreach \i in {0,72,144,216,288} {
		\pgfmathsetmacro{\angle}{\i}
		\pgfmathsetmacro{\angleB}{\i+144}
		\draw (\x*\step cm + 0.5*\size cm + 0.5*\size cm*cos(\angle), 
		\y*\step cm + 0.5*\size cm + 0.5*\size cm*sin(\angle)) --
		(\x*\step cm + 0.5*\size cm + 0.2*\size cm*cos(\angleB), 
		\y*\step cm + 0.5*\size cm + 0.2*\size cm*sin(\angleB));
	}
}

\newcommand{\drmplus}{%
	\drmminus
	\drmup
}

\newcommand{\drmcross}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm) -- ++(0cm,\size cm);
	\draw (\x*\step cm, \y*\step cm + 0.5*\size cm) -- ++(\size cm,0cm);
}

\newcommand{\drmdot}{%
	\fill (\x*\step cm + 0.5*\size cm, \y*\step cm + 0.5*\size cm) circle (0.1*\size cm);
}

\newcommand{\drmring}{%
	\draw (\x*\step cm + 0.5*\size cm, \y*\step cm + 0.5*\size cm) circle (0.4*\size cm);
	\fill (\x*\step cm + 0.5*\size cm, \y*\step cm + 0.5*\size cm) circle (0.1*\size cm);
}

% Комбинированные паттерны
\newcommand{\drmcirclex}{%
	\drmcircle
	\drmx
}

\newcommand{\drmsquarex}{%
	\drmsquare
	\drmx
}

\newcommand{\drmsquareminus}{%
	\drmsquare
	\drmminus
}

\newcommand{\drmsquareplus}{%
	\drmsquare
	\drmplus
}

\newcommand{\drmcircletriangle}{%
	\drmcircle
	\drmtriangle
}

\newcommand{\drmsquaretriangle}{%
	\drmsquare
	\drmtriangle
}

\newcommand{\drmcirclestar}{%
	\drmcircle
	\drmstar
}

\newcommand{\drmsquarestar}{%
	\drmsquare
	\drmstar
}

\newcommand{\drmtrianglestar}{%
	\drmtriangle
	\drmstar
}

\newcommand{\drmcrosscircle}{%
	\drmcross
	\drmcircle
}

\newcommand{\drmcrosssquare}{%
	\drmcross
	\drmsquare
}

\newcommand{\drmpluscircle}{%
	\drmplus
	\drmcircle
}

\newcommand{\drmplussquare}{%
	\drmplus
	\drmsquare
}

\newcommand{\drmringcross}{%
	\drmring
	\drmcross
}

\newcommand{\drmhexagonplus}{%
	\drmhexagon
	\drmplus
}

\newcommand{\drmdiamonddot}{%
	\drmdiamond
	\drmdot
}

\AddToShipoutPictureBG{%
	\begin{tikzpicture}[remember picture, overlay]
		\begin{scope}[thin, \MYPKG@color]
			\pgfmathsetmacro{\step}{\MYPKG@step}
			\pgfmathsetmacro{\size}{\MYPKG@size}
			
			% Устанавливаем seed для детерминированности
			\pgfmathsetseed{\MYPKG@seed}
			
			% Для dense режима используем меньший шаг
			\ifMYPKG@dense
			\pgfmathsetmacro{\step}{0.5}
			\pgfmathsetmacro{\size}{0.2}
			\fi
			
			\pgfmathsetmacro{\xmin}{-10}
			\pgfmathsetmacro{\xmax}{32}
			\pgfmathsetmacro{\ymin}{-5}
			\pgfmathsetmacro{\ymax}{47}
			
			\foreach \y in {\ymin,\ymin+1,...,\ymax} {
				\pgfmathsetmacro{\phase}{-(\y + 5)}
				\foreach \x in {\xmin,\xmin+1,...,\xmax} {
					\pgfmathparse{int(round(\x + \phase))}
					\let\temp\pgfmathresult
					\pgfmathparse{int(mod(abs(\temp) + \MYPKG@seed, 36))}
					\let\patternindex\pgfmathresult
					
					% Вызов соответствующей команды через \ifcase
					\ifcase\patternindex
					\drmsquare
					\or \drmcircle
					\or \drmx
					\or \drmcirclex
					\or \drmsquarex
					\or \drmsquareminus
					\or \drmsquareplus
					\or \drmminus
					\or \drmup
					\or \drmtriangle
					\or \drmtriangledown
					\or \drmdiamond
					\or \drmhexagon
					\or \drmstar
					\or \drmplus
					\or \drmcross
					\or \drmdot
					\or \drmring
					\or \drmcircletriangle
					\or \drmsquaretriangle
					\or \drmcirclestar
					\or \drmsquarestar
					\or \drmtrianglestar
					\or \drmcrosscircle
					\or \drmcrosssquare
					\or \drmpluscircle
					\or \drmplussquare
					\or \drmringcross
					\or \drmhexagonplus
					\or \drmdiamonddot
					\or \drmcross
					\or \drmplus
					\or \drmdot
					\or \drmring
					\or \drmstar
					\or \drmhexagon
					\fi
				}
			}
		\end{scope}
	\end{tikzpicture}%
}