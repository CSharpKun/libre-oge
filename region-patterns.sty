\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{region-patterns}[2026/01/01 Background regional patterns package for Russian Exams]

\makeatletter

\RequirePackage{pgffor}
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{kvoptions}
\RequirePackage{xcolor}

\SetupKeyvalOptions{
	family=MYPKG,
	prefix=MYPKG@
}

\DeclareStringOption[0]{seed}
\DeclareBoolOption[false]{useseed}

\ProcessKeyvalOptions*

% Устанавливаем seed для генератора случайных чисел
\ifx\@empty\MYPKG@seed
\pgfmathsetseed{\time} % если seed не задан, используем время
\else
\pgfmathsetseed{\MYPKG@seed}
\fi

% Базовые фигуры
\newcommand{\drmcircle}[2]{%
	\draw (#1*\step cm + 0.15cm, #2*\step cm + 0.15cm) circle (0.2cm);
}

\newcommand{\drmsquare}[2]{%
	\draw (#1*\step cm, #2*\step cm) rectangle ++(0.3cm,0.3cm);
}

\newcommand{\drmx}[2]{%
	\draw (#1*\step cm, #2*\step cm) -- ++(0.3cm,0.3cm);
	\draw (#1*\step cm + 0.3cm, #2*\step cm) -- ++(-0.3cm,0.3cm);
}

\newcommand{\drmminus}[2]{%
	\draw (#1*\step cm, #2*\step cm + 0.15cm) -- ++(0.3cm,0cm);
}

\newcommand{\drmup}[2]{%
	\draw (#1*\step cm + 0.15cm, #2*\step cm) -- ++(0cm,0.3cm);
}

% Новые базовые фигуры
\newcommand{\drmtriangle}[2]{%
	\draw (#1*\step cm + 0.15cm, #2*\step cm) -- ++(0.15cm,0.3cm) -- ++(0.15cm,-0.3cm) -- cycle;
}

\newcommand{\drmdiamond}[2]{%
	\draw (#1*\step cm + 0.15cm, #2*\step cm) -- ++(0.15cm,0.15cm) -- ++(0.15cm,-0.15cm) -- ++(-0.15cm,-0.15cm) -- cycle;
}

\newcommand{\drmplus}[2]{%
	\drmminus{#1}{#2}
	\drmup{#1}{#2}
}

\newcommand{\drmstar}[2]{%
	\drmx{#1}{#2}
	\drmplus{#1}{#2}
}

\newcommand{\drmdot}[2]{%
	\fill (#1*\step cm + 0.15cm, #2*\step cm + 0.15cm) circle (0.05cm);
}

\newcommand{\drmhexagon}[2]{%
	\draw (#1*\step cm + 0.15cm, #2*\step cm) -- ++(0.1cm,0.15cm) -- ++(0.1cm,0cm) -- ++(0.1cm,-0.15cm) -- ++(-0.1cm,-0.15cm) -- ++(-0.1cm,0cm) -- cycle;
}

% Комбинированные фигуры
\newcommand{\drmcirclex}[2]{%
	\drmcircle{#1}{#2}
	\drmx{#1}{#2}
}

\newcommand{\drmsquarex}[2]{%
	\drmsquare{#1}{#2}
	\drmx{#1}{#2}
}

\newcommand{\drmsquareminus}[2]{%
	\drmsquare{#1}{#2}
	\drmminus{#1}{#2}
}

\newcommand{\drmsquareplus}[2]{%
	\drmsquare{#1}{#2}
	\drmplus{#1}{#2}
}

\newcommand{\drmcirclestar}[2]{%
	\drmcircle{#1}{#2}
	\drmstar{#1}{#2}
}

\newcommand{\drmsquarestar}[2]{%
	\drmsquare{#1}{#2}
	\drmstar{#1}{#2}
}

% Основной паттерн - теперь с 13 различными фигурами
\AddToShipoutPictureBG{%
	\begin{tikzpicture}[remember picture, overlay]
		\begin{scope}[thin, gray!20]
			\pgfmathsetmacro{\step}{0.75}
			\pgfmathparse{random(0,12)} % диапазон 0-12 для 13 фигур
			\let\shift\pgfmathresult
			\foreach \y in {-3,-2,...,40} {
				\pgfmathsetmacro{\phase}{-(\y + 5)}
				\foreach \x in {-8,-7,...,30} {
					\pgfmathparse{int(round(\x + \phase))}
					\pgfmathresult
					\pgfmathparse{int(mod(abs(\pgfmathresult) + \shift, 13))}
					\pgfmathresult
					\ifnum\pgfmathresult=0 \drmsquare{\x}{\y} \fi
					\ifnum\pgfmathresult=1 \drmcircle{\x}{\y} \fi
					\ifnum\pgfmathresult=2 \drmx{\x}{\y} \fi
					\ifnum\pgfmathresult=3 \drmcirclex{\x}{\y} \fi
					\ifnum\pgfmathresult=4 \drmsquarex{\x}{\y} \fi
					\ifnum\pgfmathresult=5 \drmsquareminus{\x}{\y} \fi
					\ifnum\pgfmathresult=6 \drmsquareplus{\x}{\y} \fi
					\ifnum\pgfmathresult=7 \drmtriangle{\x}{\y} \fi
					\ifnum\pgfmathresult=8 \drmdiamond{\x}{\y} \fi
					\ifnum\pgfmathresult=9 \drmplus{\x}{\y} \fi
					\ifnum\pgfmathresult=10 \drmstar{\x}{\y} \fi
					\ifnum\pgfmathresult=11 \drmdot{\x}{\y} \fi
					\ifnum\pgfmathresult=12 \drmhexagon{\x}{\y} \fi
				}
			}
		\end{scope}
	\end{tikzpicture}%
}

\makeatother