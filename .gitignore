*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.mx1
*.mx2
*.mx3

# ---- Файлы для конкретных движков и пакетов ----
*.fls
*.fdb_latexmk
*.xdv
svg-inkscape/

# ---- Результат компиляции ----
*.pdf

# ---- Системные файлы и файлы редакторов ----
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
